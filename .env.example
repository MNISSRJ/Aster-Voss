# Aster Voss local configuration
# Copy this file to .env or run Start_Aster_Voss.bat and enter your key once.
MAIN_PROVIDER=deepseek
AUTO_ROUTING=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=
JEV_API_KEY=
JEV_BASE_URL=https://www.jevai.org
JEV_TIMEOUT=8
LLM_TIMEOUT=60
MAX_TOKENS=2048
LOG_LEVEL=INFO
ASTER_PORT=8010
ASTER_DEFAULT_USER_ID=mint
CRON_SECRET=
ASTER_REQUIRE_AUTH=false
ASTER_ACCESS_TOKEN=
MEMORY_RETRIEVAL_MODE=lexical
